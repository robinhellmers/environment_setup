#!/bin/bash

# Go to Downloads
alias cdd="cd $HOME/Downloads"

cdp()
{
    # Get the last argument of the previous command
    local last_arg="$_"

    # Check if the last argument is a directory
    if [ -d "$last_arg" ]
    then
        cd "$last_arg"
    elif [ -f "$last_arg" ]
    then
        cd "$(dirname "$last_arg")"
    else
        echo "The last argument is neither a directory nor a file: '$last_arg'"
    fi
}

